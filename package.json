{
  "name": "pedigree-insights",
  "version": "1.3.0",
  "description": "Open-source, source-agnostic macOS analysis tool for pedigree SQLite databases (e.g. BreedMate .db). Read-only. Pedigree bracket chart, an Indented Tree text pedigree (exportable to .txt), Linebreeding crosses, and a Foundation-contribution report.",
  "author": "Yuliya",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "npm rebuild better-sqlite3",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
